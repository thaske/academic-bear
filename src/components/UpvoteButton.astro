---
interface Props {
  uid: string;
  title: string;
}

const { uid, title } = Astro.props;
---

<form id="upvote-form" action="/upvote/" method="post" style="display: inline">
  <small>
    <input hidden name="uid" value={uid} style="display:none" />
    <input hidden name="title" value={title} style="display:none" />
    <button
      class="upvote-button"
      aria-label="Toast this post"
      title="Toast this post"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="css-i6dzq1"
      >
        <polyline points="17 11 12 6 7 11"></polyline>
        <polyline points="17 18 12 13 7 18"></polyline>
      </svg>
      <small class="upvote-count" aria-hidden="true">&nbsp;</small>
    </button>
  </small>
</form>
<script>
  const $upvoteButton =
    document.querySelector<HTMLButtonElement>(".upvote-button");
  const $upvoteCount = document.querySelector<HTMLElement>(".upvote-count");
  if ($upvoteButton && $upvoteCount) {
    $upvoteCount.innerText = localStorage.getItem("bear-upvotes") || "0";
    $upvoteButton.addEventListener("click", (e) => {
      e.preventDefault();
      const newUpvoteCount = `${parseInt($upvoteCount.innerHTML.split(" ")[0] || "0") + 1}`;
      localStorage.setItem("bear-upvotes", newUpvoteCount);
      $upvoteButton.disabled = true;
      $upvoteButton.style.color = "salmon";
      $upvoteButton.ariaLabel = `Toasted (${newUpvoteCount})`;
      $upvoteButton.title = "Toasted";
      $upvoteCount.innerHTML = newUpvoteCount;
    });
  }
</script>
